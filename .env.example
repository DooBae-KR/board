PORT=3000
# Meta 앱 > 웹훅 설정 시 입력하는 확인 토큰 (임의 문자열)
VERIFY_TOKEN=change-me
# Meta 앱 시크릿 (웹훅 서명 검증용)
APP_SECRET=

# 한국어 계정
IG_KO_USER_ID=
IG_KO_ACCESS_TOKEN=
# 영어 계정
IG_EN_USER_ID=
IG_EN_ACCESS_TOKEN=

# 대시보드 접근 토큰 (필수: 비어 있으면 /dashboard 접근 불가). 예: /dashboard?token=...
DASHBOARD_TOKEN=
# 로그인 계정은 환경변수가 아니라 Supabase 테이블 harness_admins에 둔다 (node scripts/admin-user.js). DASHBOARD_TOKEN은 세션 암호화 키와 스크립트(Bearer)용이다.

# 저장소의 data/repos.json 자동 동기화 (선택). 설정하면 5분마다 가져와 REPOS_FILE에 반영
# REPOS_SYNC_REPO=DooBae-KR/board
# REPOS_SYNC_BRANCH=main
# REPOS_SYNC_INTERVAL_MIN=5
# 비공개 저장소면 읽기 전용 토큰 필요 (Fine-grained PAT: 해당 저장소 Contents: Read-only)
# GITHUB_TOKEN=

# 하네스 (CLAUDE.md) — Supabase. 서비스 롤 키는 서버·스크립트 전용, 브라우저에 넣지 말 것
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 에이전트(Actor)가 서버 API로 보고할 때 쓰는 토큰 (임의의 긴 문자열, DASHBOARD_TOKEN과 다르게)
HARNESS_API_TOKEN=
# 서버 시작 시 agents/*.md를 Supabase에 동기화 (0이면 끔)
# HARNESS_SYNC=1
# 서버 밖에서 harness-report.js를 쓸 때: 설정하면 Supabase 대신 이 서버 API로 보고
# HARNESS_API_URL=https://<서버 주소>
# 설치된 Chrome으로 HyperFrames 렌더 (자동 다운로드가 막힌 경우)
# HYPERFRAMES_BROWSER_PATH=/usr/bin/google-chrome
